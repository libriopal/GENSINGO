<?xml version="1.0" encoding="utf-8"?>
<!-- Patch locations are the single most sensitive thing this app holds: a digger's honey
     holes. Nothing is backed up off-device unless the user explicitly exports (PRD §8.3). -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
